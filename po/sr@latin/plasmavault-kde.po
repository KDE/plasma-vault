#, kde-format
msgid "Unable to lock the vault because it is being used by %1"
msgstr "Ne mogu da zaključam trezor jer ga koristi %1"

#: kded/engine/vault.cpp:540
#, kde-format
msgid "Failed to fetch the list of applications using this vault"
msgstr "Ne mogu da dobavim listu programa koji koriste ovaj trezor."

#: kded/engine/vault.cpp:592
#, kde-format
msgid "Cannot delete the vault; there are other vaults with overlapping paths."
msgstr ""
"Ne mogu da obrišem trezor; postoje drugi trezori sa preklapajućim putanjama."

#: kded/engine/vault.cpp:597
#, kde-format
msgid "The vault is unknown; cannot dismantle it."
msgstr "Trezor je nepoznat; ne mogu da ga uništim."

#: kded/engine/vault.cpp:600
#, kde-format
msgid "Are you sure you want to delete this vault"
msgstr "Želite li zaista da obrišete ovaj trezor"

#: kded/engine/vault.cpp:601
#, kde-format
msgid ""
"This operation will irreversibly delete the following:\n"
"%1\n"
"%2"
msgstr ""
"Ovaj postupak će nepovratno obrisati sledeće:\n"
"%1\n"
"%2"

#: kded/engine/vault.cpp:603
#, kde-format
msgid "Delete operation cancelled"
msgstr "Brisanje je otkazano"

#: kded/service.cpp:491
#, kde-format
msgid "Error deleting vault"
msgstr "Greška pri brisanju trezora"

