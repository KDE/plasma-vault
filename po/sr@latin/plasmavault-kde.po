#, kde-format
msgid "This device is not initialized. Cannot import it."
msgstr "Ovaj uređaj nije pripremljen. Ne mogu da ga uvezem."

#: kded/engine/vault.cpp:458
#, kde-format
msgid "Cannot unlock an unknown vault."
msgstr "Ne mogu da otključam nepoznat trezor."

#: kded/engine/vault.cpp:473
#, kde-format
msgid "The vault is unknown; cannot lock it."
msgstr "Trezor je nepoznat; ne mogu da ga zaključam."

#: kded/engine/vault.cpp:494
#, kde-format
msgid "Unable to lock the vault because an application is using it"
msgstr "Ne mogu da zaključam trezor jer ga koristi neki program"

