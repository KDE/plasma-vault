msgstr "Желите ли заиста да обришете овај трезор"

#: kded/engine/vault.cpp:601
#, kde-format
msgid ""
"This operation will irreversibly delete the following:\n"
"%1\n"
"%2"
msgstr ""
"Овај поступак ће неповратно обрисати следеће:\n"
"%1\n"
"%2"

#: kded/engine/vault.cpp:603
#, kde-format
msgid "Delete operation cancelled"
msgstr "Брисање је отказано"

#: kded/service.cpp:491
#, kde-format
