#: kded/engine/backends/cryfs/cryfsbackend.cpp:92
#: kded/engine/backends/encfs/encfsbackend.cpp:51
#: kded/engine/backends/gocryptfs/gocryptfsbackend.cpp:77
#, kde-format
msgid "Failed to create directories, check your permissions"
msgstr "Не могу да правим фасцикле, проверите дозволе."

#: kded/engine/backends/cryfs/cryfsbackend.cpp:131
#, kde-format
msgid "Upgrade the vault?"
msgstr "Надоградити трезор?"

#: kded/engine/backends/cryfs/cryfsbackend.cpp:132
#, kde-format
msgid ""
"This vault was created with an older version of cryfs and needs to be "
"upgraded.\n"
"\n"
"Mind that this process is irreversible and the vault will no longer work "
"with older versions of cryfs.\n"
"\n"
"Do you want to perform the upgrade now?"
msgstr ""
"Овај трезор је направљен старијим издањем криФС‑а и мора да се надогради.\n"
"\n"
"Имајте у виду да је овај поступак неповратан и да трезор више неће радити са "
"старијим издањима криФС‑а.\n"
"\n"
"Желите ли сада да извршите надоградњу?"

#: kded/engine/backends/cryfs/cryfsbackend.cpp:136
#, kde-format
msgid ""
"The vault needs to be upgraded before it can be unlocked with this version "
"of cryfs"
msgstr ""
"Трезор мора да се надогради да би могао да се откључа овим издањем криФС‑а"

#: kded/engine/backends/cryfs/cryfsbackend.cpp:150
#: kded/engine/fusebackend_p.cpp:45
#, kde-format
msgid "The mount point directory is not empty; refusing to unlock the vault"
msgstr "Фасцикла за тачку монтирања није празна; одбијам да откључам трезор"

#: kded/engine/backends/cryfs/cryfsbackend.cpp:158
#, kde-format
msgid "You entered the wrong password"
msgstr "Унели сте погрешну лозинку"

#: kded/engine/backends/cryfs/cryfsbackend.cpp:162
#, kde-format
msgid "The installed version of cryfs is too old to unlock this vault."
msgstr ""
"Инсталирано издање криФС‑а је превише старо да би откључало овај трезор."

#: kded/engine/backends/cryfs/cryfsbackend.cpp:169
#: kded/engine/backends/gocryptfs/gocryptfsbackend.cpp:120
#, kde-format
msgid "Unable to perform the operation (error code %1)."
msgstr "Не могу да изведем поступак (ко̂д грешке %1)."

#: kded/engine/backends/gocryptfs/gocryptfsbackend.cpp:110
#, kde-format
msgid "The cipher directory is not empty, cannot initialise the vault."
msgstr ""
"Фасцикла са шифрованим подацима није празна, не могу да припремим трезор."

#: kded/engine/backends/gocryptfs/gocryptfsbackend.cpp:113
#, kde-format
msgid "The password is empty, cannot initialise the vault."
msgstr "Лозинка је празна, не могу да припремим трезор."

#: kded/engine/backends/gocryptfs/gocryptfsbackend.cpp:116
#, kde-format
msgid ""
"Cannot write gocryptfs.conf inside cipher directory, check your permissions."
msgstr ""
"Не могу да упишем gocryptfs.conf у фасциклу са шифрованим подацима, "
"проверите дозволе."

#: kded/engine/backends/gocryptfs/gocryptfsbackend.cpp:144
#: kded/engine/fusebackend_p.cpp:192
#, kde-format
msgid "Failed to execute"
msgstr "Не могу да извршим."

#: kded/engine/backends/gocryptfs/gocryptfsbackend.cpp:154
#: kded/engine/backends/gocryptfs/gocryptfsbackend.cpp:169
#: kded/engine/fusebackend_p.cpp:204
#, kde-format
msgid "Unable to detect the version"
msgstr "Не могу да откријем издање."

#: kded/engine/backends/gocryptfs/gocryptfsbackend.cpp:163
#, kde-format
msgid "Unable to detect the version, the version string is invalid"
msgstr "Не могу да откријем издање, ниска издања није исправна"

#: kded/engine/backends/gocryptfs/gocryptfsbackend.cpp:177
#, kde-format
msgid "Wrong version installed. The required version is %1.%2"
msgstr "Инсталирано погрешно издање. Неопходно је издање %1.%2"

#: kded/engine/backends/gocryptfs/gocryptfsbackend.cpp:180
#: kded/engine/fusebackend_p.cpp:218
#, kde-format
msgid "Correct version found"
msgstr "Нађено добро издање."

#: kded/engine/fusebackend_p.cpp:54
#, kde-format
msgid "Unable to perform the operation"
msgstr "Не могу да изведем поступак."

